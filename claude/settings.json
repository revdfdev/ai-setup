{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)"
    ],
    "defaultMode": "auto"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "low"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "low"
    },
    "claude-fable-5-2": {
      "effortLevel": "low"
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"@HOOKS@/guard-bash.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false
}
