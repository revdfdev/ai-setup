{
  "ai-setup-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"@HOOKS@/guard-bash.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "ai-setup-proof-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "/usr/bin/python3 -I \"@HOOKS@/proof-gate.py\"",
        "timeout": 15
      }
    ]
  }
}
